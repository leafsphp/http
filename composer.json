{
    "name": "leafs/http",
    "description": "Http abstraction for Leaf PHP",
    "keywords": [
        "http",
        "request",
        "response",
        "headers",
        "leaf",
        "php",
        "framework"
    ],
    "homepage": "https://leafphp.dev/modules/http/v/2/request.html",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Darko",
            "email": "mickdd22@gmail.com",
            "homepage": "https://mychi.netlify.app",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Leaf\\Http\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "leafs/anchor": "*",
        "leafs/form": "^3.0",
        "leafs/fs": "^4.0"
    },
    "extra": {
        "branch-alias": {
            "dev-v5.x": "5.0.x-dev"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "*",
        "leafs/alchemy": "v5.x-dev"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/alchemy test",
        "lint": "./vendor/bin/alchemy lint",
        "fmt": "./vendor/bin/alchemy fmt",
        "ci": "./vendor/bin/alchemy ci"
    }
}
